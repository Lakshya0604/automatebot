<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatebot - voice remote"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android TV IP address" />

        <EditText
            android:id="@+id/ipEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 192.168.1.20"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADB port (usually 5555)" />

        <EditText
            android:id="@+id/portEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5555"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake word" />

        <EditText
            android:id="@+id/wakeEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="bot one"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP8266 IP (stage 2, optional)" />

        <EditText
            android:id="@+id/esp32Edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="leave empty for now"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IR phone node (optional): IP of the OTHER phone that has an IR blaster" />

        <EditText
            android:id="@+id/nodeEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 192.168.1.7 (shown on that phone's notification)"
            android:inputType="text|textNoSuggestions" />

        <Button
            android:id="@+id/nodeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run IR node on this phone (has IR blaster)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini API key (optional, free, helps with free-form speech)" />

        <EditText
            android:id="@+id/geminiEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="leave empty to skip"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website control (optional): Firebase database URL" />

        <EditText
            android:id="@+id/dbEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://xxxx-default-rtdb.firebaseio.com"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website room code (secret, auto-created; enter it on the website)" />

        <EditText
            android:id="@+id/roomEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="auto"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IR devices: device name (e.g. ac, fan, set top box) and button (e.g. on, off, speed up, 5)" />

        <EditText
            android:id="@+id/devEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="device name"
            android:inputType="text|textNoSuggestions" />

        <EditText
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="button name"
            android:inputType="text|textNoSuggestions" />

        <Button
            android:id="@+id/learnBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn button (point remote at ESP8266 receiver)" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test button" />

        <Button
            android:id="@+id/delBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete button (leave button empty to delete device)" />

        <Button
            android:id="@+id/listBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="List learned devices" />

        <Button
            android:id="@+id/webBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open web remote (pairs automatically)" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect to TV" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/powerBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Power" />

            <Button
                android:id="@+id/volUpBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vol +" />

            <Button
                android:id="@+id/volDownBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vol -" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/homeBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home" />

            <Button
                android:id="@+id/youtubeBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YouTube" />
        </LinearLayout>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start listening" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop listening" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="13sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
